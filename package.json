{
  "name": "cyberdeck-editor",
  "productName": "Cyberdeck Editor",
  "version": "0.1.1",
  "description": "Markdown-Notizen mit [[Wikilinks]], Backlinks und Graph im Cyberpunk-Stil (Electron)",
  "main": "src/main.js",
  "author": "Cyberdeck Labs",
  "license": "GPL-3.0",
  "private": true,
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs",
    "start": "npm run build:ui && electron .",
    "dist:linux": "npm run build:ui && electron-builder --linux AppImage",
    "dist:win": "npm run build:ui && electron-builder --win nsis",
    "test:index": "node scripts/test-index.js"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "at.lea.cyberdeck.editor",
    "productName": "Cyberdeck Editor",
    "artifactName": "CyberdeckEditor-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/renderer/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "executableName": "cyberdeck-editor",
      "desktop": {
        "entry": {
          "StartupWMClass": "cyberdeck-editor"
        }
      },
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Cyberdeck Editor"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "cyberdeck-labs",
        "repo": "cyberdeck-editor",
        "releaseType": "release"
      }
    ],
    "copyright": "Copyright © 2026 Cyberdeck Labs"
  },
  "desktopName": "cyberdeck-editor.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyberdeck-labs/cyberdeck-editor.git"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.17",
    "electron": "^45.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.2.0"
  }
}
